<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
        android:background="@color/cardBg">
        <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="40dp"
            android:layout_weight="1" android:hint="搜索卡密" android:inputType="text" android:singleLine="true"
            android:padding="8dp" android:textSize="14sp" android:background="@drawable/input_bg"/>
        <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:padding="8dp" android:textSize="13sp"
            android:textColor="@color/textSecondary"/>
    </LinearLayout>
    <ListView android:id="@+id/listCards" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider"
        android:dividerHeight="1dp" android:padding="8dp"/>
    <Button android:id="@+id/btnGenerate" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="+ 批量生成卡密" android:textSize="16sp"
        android:textColor="@color/onPrimary" android:background="@drawable/btn_bg" android:layout_margin="8dp"/>
</LinearLayout>
