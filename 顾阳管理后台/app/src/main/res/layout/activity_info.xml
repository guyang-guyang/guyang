<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="48dp"
        android:hint="搜索资讯" android:inputType="text" android:singleLine="true" android:padding="8dp"
        android:textSize="14sp" android:background="@color/cardBg" android:layout_margin="8dp"/>
    <ListView android:id="@+id/listInfo" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider"
        android:dividerHeight="1dp" android:padding="8dp"/>
    <Button android:id="@+id/btnAdd" android:layout_width="match_parent" android:layout_height="56dp"
        android:text="+ 发布资讯" android:textSize="16sp" android:textColor="@color/onPrimary"
        android:background="@drawable/btn_bg" android:layout_margin="8dp"/>
</LinearLayout>
