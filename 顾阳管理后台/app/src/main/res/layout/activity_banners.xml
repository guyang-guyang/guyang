<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical"
    android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="选择轮播资讯（最多5条）" android:textColor="@color/onSurface"
        android:textSize="16sp" android:textStyle="bold"
        android:paddingBottom="8dp" />
    <TextView android:id="@+id/tv_selected" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="已选择: 0/5"
        android:textColor="@color/primary" android:textSize="14sp"
        android:paddingBottom="10dp" />
    <ListView android:id="@+id/list_info" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:choiceMode="multipleChoice" android:divider="@color/divider"
        android:dividerHeight="0.5dp" />
    <Button android:id="@+id/btn_save" android:layout_width="match_parent"
        android:layout_height="44dp" android:text="保存轮播设置"
        android:textSize="14sp" android:textColor="#FFFFFF"
        android:background="@drawable/btn_bg" android:layout_marginTop="10dp" />
</LinearLayout>
