<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:background="@color/cardBg" android:layout_marginBottom="4dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvUsername" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="@color/textPrimary" android:textStyle="bold"/>
        <TextView android:id="@+id/tvUserId" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/textSecondary" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvPoints" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/primary"
        android:textStyle="bold" android:layout_marginRight="12dp"/>
    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="12sp" android:padding="4dp"/>
</LinearLayout>
