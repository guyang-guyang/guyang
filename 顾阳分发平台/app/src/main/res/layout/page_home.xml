<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical">
    <EditText android:id="@+id/et_search" android:layout_width="match_parent"
        android:layout_height="40dp" android:layout_marginLeft="14dp" android:layout_marginRight="14dp"
        android:layout_marginTop="10dp" android:hint="搜索应用..."
        android:paddingLeft="12dp" android:paddingRight="12dp"
        android:background="@drawable/bg_card_white" android:textSize="14sp"
        android:textColor="@color/onSurface" android:singleLine="true" />
    <FrameLayout android:id="@+id/banner_box" android:layout_width="match_parent" android:layout_height="130dp"
        android:layout_margin="14dp" android:background="@drawable/bg_icon_placeholder" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingBottom="10dp">
        <TextView android:id="@+id/cat_software" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:gravity="center" android:text="软件" android:textSize="13sp"
            android:textColor="@color/onPrimaryContainer" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/cat_tools" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:gravity="center" android:text="工具" android:textSize="13sp"
            android:textColor="@color/onPrimaryContainer" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/cat_netearn" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:gravity="center" android:text="网赚" android:textSize="13sp"
            android:textColor="@color/onPrimaryContainer" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/cat_video" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:gravity="center" android:text="影视" android:textSize="13sp"
            android:textColor="@color/onPrimaryContainer" android:background="@drawable/bg_card_white" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="推荐应用" android:textColor="@color/onSurface" android:textSize="15sp"
        android:textStyle="bold" android:paddingLeft="14dp" android:paddingTop="4dp" android:paddingBottom="10dp" />
    <LinearLayout android:id="@+id/card_shop" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:layout_marginBottom="10dp"
        android:background="@drawable/bg_gradient_header" android:gravity="center_vertical"
        android:paddingLeft="14dp" android:paddingRight="14dp" android:orientation="horizontal"
        android:clickable="true" android:focusable="true">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="购买卡密 >" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="获取更多积分" android:textColor="#B9E4C9" android:textSize="12sp" />
    </LinearLayout>
    <ListView android:id="@+id/lv_home" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
