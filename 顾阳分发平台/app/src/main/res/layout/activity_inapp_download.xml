<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/iv_download_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:src="@drawable/ic_logo"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_download_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="应用名称"
        android:textSize="20sp"
        android:textColor="#333333"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_download_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="准备下载..."
        android:textSize="14sp"
        android:textColor="#999999" />

    <ProgressBar
        android:id="@+id/progress_download"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="40dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary"
        android:progressBackgroundTint="#E0E0E0" />

    <TextView
        android:id="@+id/tv_download_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0%"
        android:textSize="12sp"
        android:textColor="#666666" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_download_cancel"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="取消"
            android:textColor="@color/primary"
            android:background="@drawable/btn_border_primary"
            android:visibility="gone" />

        <View
            android:layout_width="20dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btn_download_action"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="暂停"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_solid_primary"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_download_install"
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:text="安装"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_solid_primary"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="下载完成后请点击安装按钮"
        android:textSize="12sp"
        android:textColor="#BBBBBB" />

</LinearLayout>